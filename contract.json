{
  "$schema": "./schema/book-platform.contract.v1.schema.json",
  "schema_version": "book-platform.contract.v1",
  "platform_id": "workflow",
  "repository": "platform-workflow",
  "status": "pilot",
  "api_version": "v1",
  "data_owner": "platform-workflow",
  "capabilities": [
    "jobs",
    "queue",
    "scheduler",
    "retry",
    "approval",
    "execution-history"
  ],
  "depends_on": [
    "identity",
    "observability"
  ],
  "current_implementation": {
    "repository": "platform-workflow",
    "source_path": "src/platform_workflow",
