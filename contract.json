      "src/platform_workflow"
    ],
    "source_status": "implemented-in-this-repository"
  },
  "migration": {
    "compatibility_adapter": "required",
    "shadow_parity": "pending",
    "cutover": "pending",
    "rollback": "required"
  },
  "migration_gates": [
    "durable execution",
    "retry semantics",
    "duplicate job protection"
  ],
  "surface_doc": "docs/CONTRACT-SURFACE.md",
  "interfaces": [
    {
      "id": "workflow.cli.task-includes",
      "kind": "cli",
      "direction": "provides",
      "name": "Root Taskfile.yml includes infra/tasks/<namespace>.yml (flattened task names)",
      "status": "current-in-solo-empire",
      "source": "infra/tasks"
    },
    {
      "id": "workflow.cli.scripts",
      "kind": "cli",
      "direction": "provides",
      "name": "Python/shell job entry points under infra/scripts invoked by tasks",
      "status": "current-in-solo-empire",
      "source": "infra/scripts"
    },
    {
      "id": "workflow.http.durable-jobs",
      "kind": "http",
      "direction": "provides",
      "name": "Versioned workspace-scoped durable jobs and leased worker API",
      "status": "implemented",
      "source": "src/platform_workflow"
    }
  ]
}
